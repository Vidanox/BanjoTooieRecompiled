# Build output. Reproducible from the committed sources, and the build
# directory alone is ~1.3 GB.
build/*
build-cmake/
*.log
*.obj
*.pdb
*.ilk
*.lib
*.exp
*.exe

# force_keep is ACCUMULATED STATE that cannot be regenerated, so it is kept even
# though it lives under build/. See "Traps" in AGENTS.md.
!build/force_keep*

# RecompiledFuncs/ is deliberately NOT ignored. It is generated, but only by the
# *patched* N64Recomp (see patches/), so it is not reproducible from a clean
# clone without building that first. Committing it lets a user build the game
# with just a compiler, and matches rsp/n_aspMain.cpp, which is committed for
# the same reason. See README "What is committed".

# lib/ holds the dependencies as git submodules (see .gitmodules), so it must
# not be ignored.

# Python bytecode from the tools.
__pycache__/
*.pyc
