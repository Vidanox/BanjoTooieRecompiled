+// Defined in threadqueue.cpp.
+bool thread_already_queued(RDRAM_ARG PTR(PTR(OSThread)) queue_, PTR(OSThread) t_);
+void report_double_queue(const char* what, RDRAM_ARG PTR(OSThread) t_);
+
 void ultramodern::schedule_running_thread(RDRAM_ARG PTR(OSThread) t_) {
     debug_printf("[Scheduling] Adding thread %d to the running queue\n", TO_PTR(OSThread, t_)->id);
+    // A thread that is already in the running queue is already scheduled to run,
+    // so scheduling it again is redundant -- and it is not harmless: the second
+    // insert links the thread to itself, which turns the queue into a cycle and
+    // makes every later walk spin forever. `do_send` unblocking a thread that is
+    // still linked here is the path that reaches it.
+    if (thread_already_queued(PASS_RDRAM running_queue, t_)) {
+        report_double_queue("redundant reschedule refused", PASS_RDRAM t_);
+        return;
+    }
     thread_queue_insert(PASS_RDRAM running_queue, t_);
     TO_PTR(OSThread, t_)->state = OSThreadState::QUEUED;
 }
diff --git a/ultramodern/src/threadqueue.cpp b/ultramodern/src/threadqueue.cpp
index f9c0fa1..35bbcfe 100644
--- a/ultramodern/src/threadqueue.cpp
+++ b/ultramodern/src/threadqueue.cpp
@@ -11,9 +11,40 @@ static PTR(OSThread)* queue_to_ptr(RDRAM_ARG PTR(PTR(OSThread)) queue) {
     return TO_PTR(PTR(OSThread), queue);
 }
 
+// A thread must never be linked into a queue twice: the second insert makes its
+// `next` point at itself, and the priority walk below then never terminates --
+// which parks the whole game with every thread waiting. Both entry points refuse
+// the duplicate instead, and report it once, because reaching it means some
+// caller scheduled a thread that was already scheduled.
+bool thread_already_queued(RDRAM_ARG PTR(PTR(OSThread)) queue_, PTR(OSThread) t_) {
+    PTR(PTR(OSThread))* cur = queue_to_ptr(PASS_RDRAM queue_);
+    for (int i = 0; i < 64 && *cur; i++) {
+        if (*cur == t_) {
+            return true;
+        }
+        cur = &TO_PTR(OSThread, *cur)->next;
+    }
+    return false;
+}
+
+void report_double_queue(const char* what, RDRAM_ARG PTR(OSThread) t_) {
+    static bool reported = false;
+    if (reported) {
+        return;
+    }
+    reported = true;
+    fprintf(stderr, "[Tooie] %s: thread %d was already queued\n",
+            what, TO_PTR(OSThread, t_)->id);
+    fflush(stderr);
+}
+
