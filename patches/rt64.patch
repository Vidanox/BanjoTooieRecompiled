@@ -0,0 +1,57 @@
+//
+// RT64
+//
+
+#include "shared/rt64_texture_copy.h"
+
+// Banjo-Tooie "Improved Shadows" (State::btImproveShadows): the game's shadow composite over the whole frame. The
+// shadow buffer is white with the casters drawn black; the game darkens with alpha = (1 - TEXEL0) * PRIM_ALPHA and
+// CLR_MEM * (1 - A), which is what this draws through alpha blending. uvScroll.x = PRIM_ALPHA, uvScale = the
+// shadow buffer's size in texels (it is sampled at the same place on screen).
+
+[[vk::push_constant]] ConstantBuffer<TextureCopyCB> gConstants : register(b0);
+
+Texture2D<float4> gInput : register(t1);
+SamplerState gSampler : register(s2);
+
+float4 PSMain(in float4 pos : SV_Position, in float2 uv : TEXCOORD0) : SV_TARGET {
+    float intensity;
+    // uvScroll.y < 0: soft shadow blur with radius = -uvScroll.y (in shadow buffer texels).
+    // Sample with a bilinear sampler on a golden-angle Vogel disk + Gaussian falloff so the
+    // blurred silhouette stays smooth and free of point-sample stamp artifacts while remaining
+    // compact enough to match the low-resolution N64 world around it.
+    if (gConstants.uvScroll.y < 0.0f) {
+        const float r = -gConstants.uvScroll.y;
+        const float2 texelSize = 1.0f / gConstants.uvScale;
+        const float2 halfTexel = 0.5f * texelSize;
+        const float2 maxUV = 1.0f - halfTexel;
+        static const int kSampleCount = 29;
+        static const float kGoldenAngle = 2.39996323f;
+        float sum = 0.0f;
+        float wSum = 0.0f;
+        [unroll]
+        for (int i = 0; i < kSampleCount; i++) {
+            const float rho = sqrt((float(i) + 0.5f) / float(kSampleCount));
+            const float theta = float(i) * kGoldenAngle;
+            float sTheta, cTheta;
+            sincos(theta, sTheta, cTheta);
+            const float2 sampleUV = clamp(uv + float2(cTheta, sTheta) * (rho * r) * texelSize, halfTexel, maxUV);
+            const float3 s = gInput.SampleLevel(gSampler, sampleUV, 0).rgb;
+            const float w = exp(-2.25f * rho * rho);
+            sum += dot(s, float3(0.299f, 0.587f, 0.114f)) * w;
+            wSum += w;
+        }
+        intensity = sum / wSum;
+    }
+    else {
+        const uint2 pixelPos = min(uint2(uv * gConstants.uvScale), uint2(gConstants.uvScale) - 1);
+        const float3 shadow = gInput.Load(uint3(pixelPos, 0)).rgb;
+        intensity = dot(shadow, float3(0.299f, 0.587f, 0.114f));
+    }
+    // uvScroll.y = 1 (BT_RT64_SHADOWS=ab only): the shadow's coverage in solid magenta, to measure it.
+    if (gConstants.uvScroll.y > 0.5f) {
+        return float4(1.0f, 0.0f, 1.0f, (intensity < 0.5f) ? 1.0f : 0.0f);
+    }
+
+    return float4(0.0f, 0.0f, 0.0f, saturate((1.0f - intensity) * gConstants.uvScroll.x));
+}
