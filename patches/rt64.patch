+        static FILE *file = nullptr;
+        static std::vector<uint32_t> wantCounts;
+        static bool opened = false;
+        if (!opened) {
+            opened = true;
+            const char *colon = std::strrchr(spec, ':');
+            if ((colon != nullptr) && (colon != spec)) {
+                for (const char *c = colon + 1; *c != '\0'; ) {
+                    wantCounts.push_back(uint32_t(std::strtoul(c, const_cast<char **>(&c), 10)));
+                    while ((*c == ',') || (*c == ' ')) {
+                        c++;
+                    }
+
+                    if ((*c < '0') || (*c > '9')) {
