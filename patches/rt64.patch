+                        const int32_t cx = int32_t(std::floor(sv.w1[0] * 0.5f));
+                        const int32_t cy = int32_t(std::floor(sv.w1[1] * 0.5f));
+                        const int32_t cz = int32_t(std::floor(sv.w1[2] * 0.5f));
