+        const DrawData &pd = prevWorkload.drawData;
+        for (uint32_t t = 0; t < uint32_t(curMap.transforms.size()); t++) {
+            const GameFrameMap::TransformMap &tm = curMap.transforms[t];
+            const uint32_t id = cd.transformGroups[cd.worldTransformGroups[t]].matrixId;
+            if (!tm.mapped || ((id >> 8) < prefix) || ((id >> 8) > prefixLast)) {
