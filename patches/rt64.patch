+    static void logSeamGaps(const Workload &curWorkload, const Workload &prevWorkload, const GameFrameMap::WorkloadMap &curMap) {
+        static const char *seamLog = std::getenv("BT_RT64_SEAMLOG");
+        if (seamLog == nullptr) {
+            return;
+        }
+
+        static char *seamEnd = nullptr;
+        static const uint32_t prefix = uint32_t(std::strtoul(seamLog, &seamEnd, 16));
+        static const uint32_t prefixLast = (seamEnd != nullptr && *seamEnd == '-') ? uint32_t(std::strtoul(seamEnd + 1, nullptr, 16)) : prefix;
