+                    }
+                }
+                const std::string path(spec, size_t(colon - spec));
+                file = std::fopen(path.c_str(), "wb");
+            }
+        }
+
+        if ((file == nullptr) || (std::find(wantCounts.begin(), wantCounts.end(), count) == wantCounts.end())) {
+            return;
+        }
+
+        std::fwrite(&matrixId, sizeof(uint32_t), 1, file);
+        std::fwrite(&count, sizeof(uint32_t), 1, file);
