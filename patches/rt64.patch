+                        const hlslpp::float4 vc(cp[i * 3], cp[i * 3 + 1], cp[i * 3 + 2], 1.0f);
+                        const hlslpp::float4 vp(pp[i * 3], pp[i * 3 + 1], pp[i * 3 + 2], 1.0f);
+                        const bool vMoved = (cp[i * 3] != pp[i * 3]) || (cp[i * 3 + 1] != pp[i * 3 + 1]) || (cp[i * 3 + 2] != pp[i * 3 + 2]);
