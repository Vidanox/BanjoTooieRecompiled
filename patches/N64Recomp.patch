+// N64Recomp rewrites every generated file on every run, including files whose
+// contents did not change. The build system only sees the new timestamp, so a
+// no-op recompile invalidates every generated translation unit and forces a
+// full rebuild -- 2343 objects, ~2 minutes for Banjo-Tooie. Verified: two
+// consecutive runs produce byte-identical output for all 2337 funcs_*.c files.
+//
+// `recompile_single_function` above already solves this for the
+// one-function-per-file mode; the multi-function and single-file modes need the
+// same treatment. Generated files are written to a temporary sibling and
+// swapped into place only when the contents differ, so an unchanged
+// regeneration leaves every timestamp alone and the build stays incremental.
+namespace {
+
+std::filesystem::path temp_output_path(const std::filesystem::path& final_path) {
+    std::filesystem::path temp_path = final_path;
+    temp_path.replace_extension(".tmp");
+    return temp_path;
+}
+
+// Move `temp_path` over `final_path`, or discard it when the contents match so
+// the destination keeps its old timestamp.
+void sync_output_file(const std::filesystem::path& temp_path,
+                      const std::filesystem::path& final_path) {
+    if (std::filesystem::exists(final_path) && compare_files(final_path, temp_path)) {
+        std::filesystem::remove(temp_path);
+        return;
+    }
+
+    std::error_code ec;
+    std::filesystem::rename(temp_path, final_path, ec);
+    if (ec) {
+        // rename() does not replace an existing file on every platform.
+        std::filesystem::remove(final_path, ec);
+        std::filesystem::rename(temp_path, final_path, ec);
+    }
+}
+
